<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the wallpaper on the left (behind the hero) and a little at the bottom, keeping its glow visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#A6000000"
                android:centerColor="#33000000"
                android:centerX="0.45"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#80000000"
                android:centerColor="#14000000"
                android:centerY="0.35"
                android:endColor="#26000000" />
        </shape>
    </item>
</layer-list>
