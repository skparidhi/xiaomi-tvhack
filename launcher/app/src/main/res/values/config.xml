<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.ps1.
  Package names: on the TV run `pm list packages`.
-->
<resources>

    <!-- Apps pinned to the Favorites row, in this order. Missing apps are skipped; free slots fill alphabetically. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tvmusic</item>
        <item>com.android.vending</item>
    </string-array>

    <!-- Hero text per app: "package|eyebrow|tagline". Apps not listed show default_eyebrow / default_tagline. -->
    <string-array name="hero_text">
        <item>com.google.android.youtube.tv|Tonight on the big screen|Everything you love, all in one place.</item>
        <item>com.amazon.amazonvideo.livingroom|Time for a great story|Movies, series and cricket. Settle in.</item>
        <item>com.google.android.youtube.tvmusic|The sound of your evening|Find your sound. Set the mood.</item>
        <item>com.android.vending|Something new|Apps and games made for your TV.</item>
        <item>com.netflix.ninja|Time for a great story|Great stories. Even better evenings.</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs tab already covers). -->
    <string-array name="hidden_apps">
        <item>com.android.tv</item>
        <item>com.mitv.gallery</item>
        <item>com.mitv.tvhome.atv</item>
        <item>com.xiaomi.mitv.tvmanager</item>
        <item>com.xiaomi.mitv.mediaexplorer</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.android.tv</string>

    <!-- Tiles per row; the Favorites row always has this many slots. -->
    <integer name="columns">6</integer>
</resources>
