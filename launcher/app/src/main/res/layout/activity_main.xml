<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Full-bleed wallpaper (res/drawable*/wallpaper) with a dark fade on the left and bottom for legibility. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <!-- Hero: the focused favourite's eyebrow, name and tagline, positioned above the Favorites row in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:alpha="0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heroEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.28"
            android:textAllCaps="true"
            android:singleLine="true" />

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="56sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <TextView
            android:id="@+id/heroTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 400"
            android:singleLine="true" />
    </LinearLayout>

    <!-- "Favorites" caption and hint, positioned just above the first row in code. -->
    <RelativeLayout
        android:id="@+id/favHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="62dp"
        android:paddingEnd="62dp"
        android:alpha="0">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="@string/favorites"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 500" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/hold_hint"
            android:shadowColor="#E6000000"
            android:shadowRadius="6"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 400" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="26dp">

        <!-- Top bar: wordmark, centred tab pill, clock. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/wordmark"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="-0.01" />

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/tab_bar_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabHome"
                    style="@style/TopTab"
                    android:text="@string/home" />

                <TextView
                    android:id="@+id/tabApps"
                    style="@style/TopTab"
                    android:text="@string/apps" />

                <TextView
                    android:id="@+id/tabInputs"
                    style="@style/TopTab"
                    android:text="@string/inputs" />

                <TextView
                    android:id="@+id/tabSettings"
                    style="@style/TopTab"
                    android:text="@string/settings" />
            </LinearLayout>

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#B3000000"
                android:shadowRadius="8"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 400" />
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single white focus ring that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
